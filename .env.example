# URL da API do BGMatch (termina em /api)
BGMATCH_API_URL=https://bgmatch.vps.rodrigor.com/api

# Conta de serviço do MCP na tabela usuarios do BGMatch
BGMATCH_USUARIO=mcp
BGMATCH_SENHA=

# Um token por pessoa, separados por vírgula: nome:token
# Gere cada um com: npm run token -- nome
BGMATCH_MCP_TOKENS=

# Valores aceitos no cabeçalho Host (proteção contra DNS rebinding)
BGMATCH_MCP_HOSTS=bgmatch.vps.rodrigor.com,localhost,127.0.0.1

PORT=8096
